includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # La meta es volver al nivel 7. Hoy el código pasa limpio en 1; los avisos
    # que faltan son de anotaciones de tipos (qué modelo devuelve cada relación,
    # qué contiene cada arreglo), no errores de funcionamiento. Se sube de a un
    # nivel por vez, arreglando los avisos de ese nivel:
    #   nivel 2 → 127 avisos · nivel 5 → 205 · nivel 7 → 450
    level: 1
